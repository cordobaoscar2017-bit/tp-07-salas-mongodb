<section>
  <h2><%= seccion %></h2>

  <p>Listado de reservas de las salas de estudio.</p>

  <div class="acciones">
    <a href="/reservas/nueva">Nueva reserva</a>
  </div>

  <% if (reservas.length === 0) { %>

    <div class="mensaje">
      <p>No hay reservas registradas.</p>
    </div>

  <% } else { %>

    <div class="lista-reservas">

      <% reservas.forEach(reserva => { %>

        <article class="reserva">
          <h3>Reserva #<%= reserva.id %></h3>

          <p>
            <strong>Estudiante:</strong>
            <%= reserva.estudiante %>
          </p>

          <p>
            <strong>Sala:</strong>
            <%= reserva.sala %>
          </p>

          <p>
            <strong>Fecha:</strong>
            <%= reserva.fecha %>
          </p>

          <p>
            <strong>Turno:</strong>
            <%= reserva.turno %>
          </p>

          <p>
            <strong>Personas:</strong>
            <%= reserva.personas %>
          </p>

          <a href="/reservas/<%= reserva.id %>">
            Ver detalle
          </a>
        </article>

      <% }) %>

    </div>

  <% } %>
</section>